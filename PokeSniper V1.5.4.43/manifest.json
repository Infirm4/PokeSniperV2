{
  "manifest_version": 3,
  "name": "PokeIdle Market Sniper",
  "version": "1.5.4.43",
  "description": "Monitor de anúncios recentes de Pokémon com alertas de desconto em Coins e Gemas.",
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://pokeidle.io/*",
    "https://*.pokeidle.io/*",
    "https://raw.githubusercontent.com/PokeAPI/sprites/*",
    "https://briaoale.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*",
        "https://*.pokeidle.io/*"
      ],
      "js": [
        "market-core.js",
        "opportunities.js",
        "coins-history.js",
        "bridge.js",
        "market-toast.js",
        "market-badges.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://pokeidle.io/*",
        "https://*.pokeidle.io/*"
      ],
      "js": [
        "market-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_title": "PokeSniper · Oportunidades",
    "default_popup": "opportunities.html"
  }
}
