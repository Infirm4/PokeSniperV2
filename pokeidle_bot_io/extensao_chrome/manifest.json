{
  "manifest_version": 3,
  "name": "PokeIdle.io - Captura automática",
  "version": "3.0.0",
  "description": "Envia cliques de captura na lista de Pokémon caídos da aba do PokéIdle.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://pokeidle.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PokeIdle.io - Captura automática",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
