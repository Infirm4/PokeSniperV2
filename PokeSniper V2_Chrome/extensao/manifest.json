{
  "manifest_version": 3,
  "name": "PokeIdle Market Sniper",
  "version": "1.5.4.93",
  "description": "Monitor de anúncios recentes de Pokémon com alertas de desconto em Coins e Gemas.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://pokeidle.io/*",
    "https://*.pokeidle.io/*",
    "https://raw.githubusercontent.com/PokeAPI/sprites/*",
    "https://briaoale.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*",
        "https://*.pokeidle.io/*"
      ],
      "js": [
        "market-core.js",
        "opportunities.js",
        "coins-history.js",
        "bridge.js",
        "market-toast.js",
        "market-badges.js",
        "inventory-prices.js",
        "panel-launcher.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://pokeidle.io/*",
        "https://*.pokeidle.io/*"
      ],
      "js": [
        "market-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "web_accessible_resources": [{
    "resources": ["opportunities.html"],
    "matches": ["https://pokeidle.io/*", "https://*.pokeidle.io/*"]
  }],
  "action": {
    "default_title": "Poke Sniper V2",
    "default_popup": "opportunities.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
